# Build machine: URL prefix the proxy serves the app under ("/" for its own hostname)
BASE_PATH=/store/

# Server: address and port the container is published on for the reverse proxy
APP_BIND=127.0.0.1
APP_PORT=3000


# Server: automatic backups (0 hours turns them off). Backups go to data/backups unless you
# mount another disk at /backups in docker-compose.yml and set BACKUP_DIR_IN_CONTAINER=/backups.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
BACKUP_DIR_IN_CONTAINER=
