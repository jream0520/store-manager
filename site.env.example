# Site-specific values for this deployment: hostnames, addresses, SSH target.
# Copy to site.env (git-ignored) and fill in. The docs refer to these by name, e.g. <PUBLIC_URL>.
# deploy.ps1 reads DEPLOY_TARGET and DEPLOY_DIR from site.env.
# See docs/OPERATIONS.md, "Site settings (site.env)".

# SSH target for the server, user@host (dev machine → server)
DEPLOY_TARGET=user@server
# Folder on the server holding docker-compose.yml, .env and data/
DEPLOY_DIR=~/store-manager
# Public address of the app, including the /store/ path
PUBLIC_URL=https://example.com/store/
# Server's LAN IP address (the reverse proxy reaches the app here; matches APP_BIND in the server's .env)
SERVER_LAN_IP=192.168.0.10
# Host port the app is published on (matches APP_PORT in the server's .env)
APP_PORT=3000
# Home network range, for the optional "LAN only" proxy rule
LAN_SUBNET=192.168.0.0/24
