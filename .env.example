# Build machine: URL prefix the proxy serves the app under ("/" for its own hostname)
BASE_PATH=/store/

# Server: address and port the container is published on for the reverse proxy
APP_BIND=127.0.0.1
APP_PORT=3000

# Server: enables the M1 photo-upload test page. Use a long random value
# (e.g. `openssl rand -hex 16`); remove it once testing is done.
SPIKE_UPLOAD_KEY=
